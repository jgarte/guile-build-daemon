set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
set -- -C "$root/env/guix/gxd/env/guix/channels.scm" "$@"

# Newer Guix requires this opt-out; older Guix rejects it.
if guix time-machine --help 2>/dev/null |
   grep -q -- --unsafe-channel-evaluation
then
  set -- --unsafe-channel-evaluation "$@"
fi

exec guix time-machine "$@"
